    Rôle : Présente le formulaire permettant de créer une commande de pizza.
-->
<!DOCTYPE html>
<html lang="fr">

<head>
    <meta charset="UTF-8">
    <title>Accueil</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
        rel="stylesheet">
</head>

<body class="bg-light">

<%- include('../partials/header') %>

<main class="container py-5">

    <div class="card shadow-lg border-0 rounded-4">

        <div class="card-body p-4 p-md-5">

            <h1 class="text-center mb-4">
                Commander une pizza
            </h1>

            <form action="/resultat" method="POST">

                <!-- Choix de la pizza et de ses options. -->
                <div class="mb-4">

                    <label class="form-label fw-bold">
                        Quel type de pizza voulez-vous ?
                    </label>

                    <div class="d-flex flex-wrap gap-2">

                        <input class="btn-check"
                               type="radio"
                               id="pizza1"
                               name="pizza"
                               value="Hawaienne"
                               required>

                        <label class="btn btn-outline-primary"
                               for="pizza1">
                            Hawaienne
                        </label>


                        <input class="btn-check"
                               type="radio"
                               id="pizza2"
                               name="pizza"
                               value="All Dressed">

                        <label class="btn btn-outline-primary"
                               for="pizza2">
                            All Dressed
                        </label>


                        <input class="btn-check"
                               type="radio"
                               id="pizza3"
                               name="pizza"
                               value="Sicilienne">

                        <label class="btn btn-outline-primary"
                               for="pizza3">
                            Sicilienne
                        </label>

                    </div>

                </div>


                <div class="mb-4">

                    <label class="form-label fw-bold">
                        Quelle quantité ?
                    </label>

                    <input
                        class="form-control"
                        type="number"
                        name="quantite"
                        min="1"
                        max="99"
                        required>

                </div>


                <div class="mb-4">

                    <label class="form-label fw-bold">
                        Quelle taille ?
                    </label>

                    <select
                        class="form-select"
                        id="taille"
                        name="taille"
                        required>

                        <option value="" disabled selected>
                            Choisir une taille
                        </option>

                        <option value="petite">Petite</option>
                        <option value="moyenne">Moyenne</option>
                        <option value="grande">Grande</option>

                    </select>

                </div>


                <div class="mb-4">

                    <label class="form-label fw-bold">
                        Ingrédients supplémentaires
                    </label>

                    <div class="form-check">

                        <input
                            class="form-check-input"
                            type="checkbox"
                            id="ingredient1"
                            name="ingredients"
                            value="pepperoni">

                        <label class="form-check-label" for="ingredient1">
                            Pepperoni
                        </label>

                    </div>


                    <div class="form-check">

                        <input
                            class="form-check-input"
                            type="checkbox"
                            id="ingredient2"
                            name="ingredients"
                            value="mozzarella">

                        <label class="form-check-label" for="ingredient2">
                            Mozzarella
                        </label>

                    </div>


                    <div class="form-check">

                        <input
                            class="form-check-input"
                            type="checkbox"
                            id="ingredient3"
                            name="ingredients"
                            value="oeuf">

                        <label class="form-check-label" for="ingredient3">
                            Œuf
                        </label>

                    </div>

                </div>


                <hr class="my-4">


                <h2 class="h4 mb-3">
                    Informations de livraison
                </h2>


                <!-- Informations nécessaires à la livraison. -->
                <div class="mb-3">

                    <label class="form-label">
                        Adresse
                    </label>

                    <textarea
                        class="form-control"
                        name="adresse"
                        rows="3"
                        required></textarea>

                </div>


                <div class="mb-3">

                    <label class="form-label">
                        Code postal
                    </label>

                    <input
                        class="form-control"
                        type="text"
                        name="code_postal"
                        placeholder="A1A 1A1"
                        pattern="[A-Za-z][0-9][A-Za-z] [0-9][A-Za-z][0-9]"
                        title="Format : A1A 1A1"
                        required>

                </div>


                <div class="row">

                    <div class="col-md-6 mb-3">

                        <label class="form-label">
                            Nom
                        </label>

                        <input
                            class="form-control"
                            type="text"
                            name="nom"
                            pattern="[A-Za-zÀ-ÿ '-]+"
                            title="Lettres seulement"
                            required>

                    </div>


                    <div class="col-md-6 mb-3">

                        <label class="form-label">
                            Prénom
                        </label>

                        <input
                            class="form-control"
                            type="text"
                            name="prenom"
                            pattern="[A-Za-zÀ-ÿ '-]+"
                            title="Lettres seulement"
                            required>

                    </div>

                </div>


                <div class="mb-3">

                    <label class="form-label">
                        Téléphone
                    </label>

                    <input
                        class="form-control"
                        type="text"
                        name="telephone"
                        placeholder="514-123-4567"
                        pattern="[0-9]{3}-[0-9]{3}-[0-9]{4}"
                        title="Format : 514-123-4567"
                        required>

                </div>


                <div class="mb-3">

                    <label class="form-label">
                        Courriel
                    </label>

                    <input
                        class="form-control"
                        type="email"
                        name="courriel"
                        placeholder="votre@email.com"
                        required>

                </div>


                <div class="mb-4">

                    <label class="form-label">
                        Mode de paiement
                    </label>

                    <select
                        class="form-select"
                        id="paiement"
                        name="paiement"
                        required>

                        <option value="" disabled selected>
                            Choisir un mode de paiement
                        </option>

                        <option value="Mastercard">Mastercard</option>
                        <option value="Visa">Visa</option>
                        <option value="PayPal">PayPal</option>
                        <option value="Interac">Interac</option>
                        <option value="American Express">American Express</option>
                        <option value="Apple Pay">Apple Pay</option>
                        <option value="Google Pay">Google Pay</option>

                    </select>

                </div>


                <div class="d-grid">

                    <button
                        type="submit"
                        class="btn btn-primary btn-lg">

                        Confirmer ma commande

                    </button>

                </div>

            </form>

        </div>

    </div>

</main>

<%- include('../partials/footer') %>

</body>

</html>