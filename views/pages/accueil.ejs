<!DOCTYPE html>
<html lang="fr">

<head>
    <meta charset="UTF-8">
    <title>Accueil</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body>
    <%- include('../partials/header') %>

        <h1>Express</h1>

        <form action="/resultat" method="POST">

            <p>QUEL TYPE DE PIZZA VOULEZ-VOUS ?</p>

            <input type="radio" id="pizza1" name="pizza" value="Hawaienne" required>
            <label for="pizza1">Hawaienne</label><br>

            <input type="radio" id="pizza2" name="pizza" value="All Dressed">
            <label for="pizza2">All Dressed</label><br>

            <input type="radio" id="pizza3" name="pizza" value="Sicilienne">
            <label for="pizza3">Sicilienne</label><br>


            <p>Quelle quantité ?</p>

            <input type="number" name="quantite" min="1" max="99" required onblur="this.reportValidity()">


            <p>Quelle taille ?</p>

            <select id="taille" name="taille" required>
                <option value="" disabled selected>Choisir une taille</option>
                <option value="petite">Petite</option>
                <option value="moyenne">Moyenne</option>
                <option value="grande">Grande</option>
            </select>


            <p>Quel ingrédient supplémentaire ?</p>

            <input type="checkbox" id="ingredient1" name="ingredients" value="pepperoni">
            <label for="ingredient1">Pepperoni</label><br>

            <input type="checkbox" id="ingredient2" name="ingredients" value="mozzarella">
            <label for="ingredient2">Mozzarella</label><br>

            <input type="checkbox" id="ingredient3" name="ingredients" value="oeuf">
            <label for="ingredient3">Œuf</label><br>


            <p>Quelle adresse ?</p>

            <textarea name="adresse" required onblur="this.reportValidity()"></textarea>


            <p>Code postal ? Exemple : A1A 1A1</p>

            <input type="text" name="code_postal" pattern="[A-Za-z][0-9][A-Za-z] [0-9][A-Za-z][0-9]"
                title="Format : A1A 1A1" required onblur="this.reportValidity()">


            <p>Quel est votre nom ?</p>

            <input type="text" name="nom" pattern="[A-Za-zÀ-ÿ '-]+" title="Lettres seulement" required
                onblur="this.reportValidity()">


            <p>Quel est votre prénom ?</p>

            <input type="text" name="prenom" pattern="[A-Za-zÀ-ÿ '-]+" title="Lettres seulement" required
                onblur="this.reportValidity()">


            <p>Quel est votre numéro de téléphone ? Exemple : 514-123-4567</p>

            <input type="text" name="telephone" pattern="[0-9]{3}-[0-9]{3}-[0-9]{4}" title="Format : 514-123-4567"
                required onblur="this.reportValidity()">


            <p>Quel est votre courriel ? Exemple : votre@email.com</p>

            <input type="email" name="courriel" required onblur="this.reportValidity()">


            <p>Quel est votre mode de paiement ?</p>

            <select id="paiement" name="paiement" required>
                <option value="" disabled selected>Choisir un mode de paiement</option>
                <option value="Mastercard">Mastercard</option>
                <option value="Visa">Visa</option>
                <option value="PayPal">PayPal</option>
                <option value="Interac">Interac</option>
                <option value="American Express">American Express</option>
                <option value="Apple Pay">Apple Pay</option>
                <option value="Google Pay">Google Pay</option>
            </select>

            <br><br>

            <button type="submit">
                Confirmer ma commande
            </button>

        </form>

        <%- include('../partials/footer') %>

</body>

</html>