    Rôle : Affiche les résultats de la recherche dans l'historique des commandes.
-->
<%- include('../partials/header') %>

<main class="container py-5">

    <h1 class="mb-4">
        Historique des commandes
    </h1>

    <p>
        Numéro recherché :
        <strong><%= telephone %></strong>
    </p>

    <!-- Affiche un avertissement ou le tableau selon le résultat de la recherche. -->
    <% if (commandes.length === 0) { %>

        <div class="alert alert-warning">
            Aucune commande trouvée.
        </div>

    <% } else { %>

        <table class="table table-striped table-bordered">

            <thead class="table-dark">
                <tr>
                    <th>Pizza</th>
                    <th>Taille</th>
                    <th>Quantité</th>
                    <th>Prix total</th>
                    <th>Date</th>
                </tr>
            </thead>

            <tbody>

                <% commandes.forEach(commande => { %>

                    <tr>
                        <td><%= commande.pizza %></td>
                        <td><%= commande.taille %></td>
                        <td><%= commande.quantite %></td>
                        <td><%= commande.prixTotal %> $</td>
                        <td><%= commande.date %></td>
                    </tr>

                <% }); %>

            </tbody>
        </table>

    <% } %>

    <a href="/historique" class="btn btn-secondary">
        Nouvelle recherche
    </a>

</main>

<%- include('../partials/footer') %>