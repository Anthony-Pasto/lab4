<!DOCTYPE html>
<html lang="fr">

<head>
    <meta charset="UTF-8">
    <title>command</title>
</head>

<body>
<%- include('../partials/header') %>

<h1>Résumé de la commande</h1>

<table>
    <tbody>
        <tr>
            <th>Pizza</th>
            <td><%= pizza %></td>
            <td>
                <%= toutpris.prixPizza %> $
            </td>
        </tr>

        <tr>
            <th>Taille</th>
            <td><%= taille %></td>
            <td>
                <% if (taille === "petite") { %>
                    x0.8
                <% } else if (taille === "moyenne") { %>
                    x1.0
                <% } else if (taille === "grande") { %>
                    x1.2
                <% } %>
            </td>
        </tr>

        <tr>
            <th>Ingrédients</th>
            <td><%= ingredients %></td>
            <td>
                <%= toutpris.prixIngredients %> $
            </td>
        </tr>

        <tr>
            <th>Quantité</th>
            <td><%= quantite %></td>
        </tr>

        <tr>
            <th>Prix avant taxes</th>
            <td>  </td>
            <td><%= toutpris.prixTotalAvantTaxes %> $</td>
        </tr>
        <tr>
            <th>Prix après taxes</th>
            <td>  </td>
            <td><%= toutpris.prixTaxes %> $</td>
    </tbody>
</table>

<h2>Client</h2>

<table>
    <thead>
        <tr>
            <th>Information</th>
            <th>Valeur</th>
        </tr>
    </thead>

    <tbody>
        <tr>
            <th>Nom</th>
            <td><%= nom %></td>
        </tr>

        <tr>
            <th>Prénom</th>
            <td><%= prenom %></td>
        </tr>

        <tr>
            <th>Adresse</th>
            <td><%= adresse %></td>
        </tr>

        <tr>
            <th>Code postal</th>
            <td><%= code_postal %></td>
        </tr>

        <tr>
            <th>Téléphone</th>
            <td><%= telephone %></td>
        </tr>

        <tr>
            <th>Courriel</th>
            <td><%= courriel %></td>
        </tr>

        <tr>
            <th>Paiement</th>
            <td><%= paiement %></td>
        </tr>
    </tbody>
</table>
<%- include('../partials/footer') %>
</body>