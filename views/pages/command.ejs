    Rôle : Affiche le résumé de la commande et les informations du client.
-->
<!DOCTYPE html>
<html lang="fr">

<head>
    <meta charset="UTF-8">
    <title>Commande</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
        rel="stylesheet">
</head>

<body class="bg-light">

<%- include('../partials/header') %>

<main class="container py-5">

    <div class="card shadow-lg border-0 rounded-4 mb-4">

        <div class="card-body p-4">

            <h1 class="text-center mb-4">
                Résumé de la commande
            </h1>

            <!-- Résumé des choix et du prix calculé par le serveur. -->
            <table class="table table-striped table-bordered align-middle">

                <thead class="table-dark">
                    <tr>
                        <th>Élément</th>
                        <th>Choix</th>
                        <th>Prix / facteur</th>
                    </tr>
                </thead>

                <tbody>

                    <tr>
                        <th>Pizza</th>
                        <td><%= pizza %></td>
                        <td><%= toutpris.prixPizza %> $</td>
                    </tr>

                    <tr>
                        <th>Taille</th>
                        <td><%= taille %></td>
                        <td>
                            <% if (taille === "petite") { %>
                                x0.8
                            <% } else if (taille === "moyenne") { %>
                                x1.0
                            <% } else if (taille === "grande") { %>
                                x1.2
                            <% } %>
                        </td>
                    </tr>

                    <tr>
                        <th>Ingrédients</th>
                        <td>
                            <% if (Array.isArray(ingredients)) { %>
                                <%= ingredients.join(", ") %>
                            <% } else if (ingredients) { %>
                                <%= ingredients %>
                            <% } else { %>
                                Aucun
                            <% } %>
                        </td>
                        <td><%= toutpris.prixIngredients %> $</td>
                    </tr>

                    <tr>
                        <th>Quantité</th>
                        <td><%= quantite %></td>
                        <td>-</td>
                    </tr>

                    <tr class="table-warning">
                        <th>Prix avant taxes</th>
                        <td colspan="2" class="text-end fw-bold">
                            <%= toutpris.prixTotalAvantTaxes %> $
                        </td>
                    </tr>

                    <tr class="table-success">
                        <th>Prix après taxes</th>
                        <td colspan="2" class="text-end fw-bold fs-5">
                            <%= toutpris.prixTaxes %> $
                        </td>
                    </tr>

                </tbody>
            </table>

        </div>
    </div>


    <div class="card shadow border-0 rounded-4">

        <div class="card-body p-4">

            <h2 class="mb-4">
                Informations du client
            </h2>

            <table class="table table-bordered">

                <thead class="table-dark">
                    <tr>
                        <th>Information</th>
                        <th>Valeur</th>
                    </tr>
                </thead>

                <tbody>

                    <tr>
                        <th>Nom</th>
                        <td><%= nom %></td>
                    </tr>

                    <tr>
                        <th>Prénom</th>
                        <td><%= prenom %></td>
                    </tr>

                    <tr>
                        <th>Adresse</th>
                        <td><%= adresse %></td>
                    </tr>

                    <tr>
                        <th>Code postal</th>
                        <td><%= code_postal %></td>
                    </tr>

                    <tr>
                        <th>Téléphone</th>
                        <td><%= telephone %></td>
                    </tr>

                    <tr>
                        <th>Courriel</th>
                        <td><%= courriel %></td>
                    </tr>

                    <tr>
                        <th>Paiement</th>
                        <td><%= paiement %></td>
                    </tr>

                </tbody>

            </table>

            <div class="d-flex justify-content-center gap-2 mt-4">

                <a href="/" class="btn btn-secondary">
                    Retour
                </a>

                <button class="btn btn-success">
                    Confirmer
                </button>

            </div>

        </div>
    </div>

</main>

<%- include('../partials/footer') %>

</body>
</html>